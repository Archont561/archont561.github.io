{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "openapi": {
      "cache": false,
      "inputs": ["src/**/*.ts", "package.json"]
    },
    "generate": {
      "dependsOn": ["@archont561/github-app#openapi"],
      "inputs": ["openapi.json", "openapi-ts.config.ts", "package.json"],
      "outputs": ["src/client/**"]
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**"]
    },
    "@archont561/portfolio#test": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**"],
      "cache": false,
      "passThroughEnv": [
        "PORTFOLIO_CHROMIUM_EXECUTABLE",
        "PORTFOLIO_CHROMIUM_ARGS",
        "PLAYWRIGHT_BROWSERS_PATH",
        "XDG_CACHE_HOME",
        "LOCALAPPDATA",
        "LD_LIBRARY_PATH",
        "DYLD_LIBRARY_PATH"
      ]
    },
    "@archont561/portfolio#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/data/project-categories.json",
        "$TURBO_ROOT$/data/projects/**",
        "$TURBO_ROOT$/data/repositories.json",
        "$TURBO_ROOT$/packages/tools/src/**"
      ]
    },
    "@archont561/portfolio#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/data/packages.json",
        "$TURBO_ROOT$/data/project-categories.json",
        "$TURBO_ROOT$/data/projects/**",
        "$TURBO_ROOT$/data/repositories.json",
        "$TURBO_ROOT$/packages/tools/src/**"
      ],
      "outputs": ["out/**"]
    }
  }
}
