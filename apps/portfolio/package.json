{
  "name": "@archont561/portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Archont561 portfolio and docs site (Next.js + Fumadocs, static export)",
  "license": "MIT",
  "scripts": {
    "source": "bun run --cwd ../.. --bun tools task portfolio:projects:generate && fumadocs-mdx",
    "styles": "unocss \"src/app/**/*.{tsx,ts}\" \"src/components/**/*.{tsx,ts}\" --config uno.config.ts --out-file src/app/uno.css",
    "styles:watch": "unocss \"src/app/**/*.{tsx,ts}\" \"src/components/**/*.{tsx,ts}\" --config uno.config.ts --out-file src/app/uno.css --watch",
    "dev": "bun run source && bun run styles && next dev --webpack --hostname 0.0.0.0",
    "build": "bun run source && bun run styles && next build --webpack && bun run --cwd ../.. --bun tools export-ai && pagefind --site out",
    "typecheck": "bun run source && next typegen && tsc --noEmit",
    "test": "bun test tests features --path-ignore-patterns=\"**/seo.test.ts\"",
    "test:browser": "bun test tests/browser.test.ts",
    "test:seo": "bun test tests/seo.test.ts"
  },
  "dependencies": {
    "@archont561/github-app-client": "workspace:*",
    "@archont561/tools": "workspace:*",
    "fumadocs-core": "^16.18.4",
    "fumadocs-mdx": "^15.5.3",
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-globe.gl": "^2.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aboviq/bun-test-cucumber": "^0.2.0",
    "@archont561/bun-test-utils": "^0.2.0",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/cli": "^66.12.0",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "workbox-build": "^7.4.1"
  }
}
