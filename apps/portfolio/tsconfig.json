{
  "extends": "./.tsconfig/app.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node", "bun"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "source.config.ts",
    "uno.config.ts",
    "next-env.d.ts",
    ".source/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "tests/**/*.ts"
  ]
}
