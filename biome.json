{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["./packages/tools/src/configs/biome/base.json"],
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mjs",
      "**/*.css",
      "**/*.json",
      "**/*.jsonc",
      "!**/.next",
      "!**/.source",
      "!**/out",
      "!**/dist",
      "!**/node_modules/**",
      "!**/.bun/**",
      "!**/coverage",
      "!**/.pixi",
      "!**/.cache",
      "!**/.turbo",
      "!**/.wrangler",
      "!**/*.tsbuildinfo",
      "!**/.tools-cache/**"
    ]
  },
  "overrides": [
    {
      "includes": ["biome.json"],
      "linter": {
        "rules": {
          "suspicious": {
            "useBiomeIgnoreFolder": "off"
          }
        }
      }
    },
    {
      "includes": ["data/packages.json", "data/repositories.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
