{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["./packages/tools/src/configs/biome/base.json"],
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mjs",
      "**/*.css",
      "**/*.json",
      "**/*.jsonc",
      "!**/.next",
      "!**/.source",
      "!**/out",
      "!**/dist",
      "!**/node_modules/**",
      "!**/.bun/**",
      "!**/coverage",
      "!**/.pixi",
      "!**/.cache",
      "!**/.turbo",
      "!**/.wrangler",
      "!**/*.tsbuildinfo"
    ]
  },
  "overrides": [
    {
      "includes": ["biome.json"],
      "linter": {
        "rules": {
          "suspicious": {
            "useBiomeIgnoreFolder": "off"
          }
        }
      }
    }
  ]
}
